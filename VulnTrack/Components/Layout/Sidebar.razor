@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory

<aside class="vc-sidebar" aria-label="Primary navigation">
    <div class="vc-brand">
        <a href="/dashboard" class="vc-brand__link">
            <svg class="vc-brand__mark" viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
                <circle cx="16" cy="16" r="14.5" fill="none" stroke="currentColor" stroke-width="1.25" opacity="0.55" />
                <path d="M9.5 11.5 L14.5 22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M14.5 22 L24.5 5" fill="none" stroke="#14968c" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="vc-brand__text">
                <span class="vc-brand__word">Vuln<span>Track</span></span>
                <span class="vc-brand__sub">SecOps Console</span>
            </span>
        </a>
        <label for="vc-nav-toggle" class="vc-sidebar__close" aria-label="Close navigation">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </label>
    </div>

    <nav class="vc-nav" aria-label="Console sections">
        <div class="vc-nav__group">
            <div class="vc-nav__label">OPERATIONS</div>
            <ul class="vc-nav__list">
                <li>
                    <NavLink href="/dashboard" Match="NavLinkMatch.All" ActiveClass="is-active" class="vc-nav__item">
                        <i class="bi bi-grid-1x2" aria-hidden="true"></i>
                        <span>Dashboard</span>
                    </NavLink>
                </li>
                <AuthorizeView Roles="Administrator,Security Analyst">
                    <li>
                        <NavLink href="/import" ActiveClass="is-active" class="vc-nav__item">
                            <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
                            <span>Import Scan</span>
                        </NavLink>
                    </li>
                </AuthorizeView>
                <li>
                    <NavLink href="/vulnerabilities" ActiveClass="is-active" class="vc-nav__item">
                        <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
                        <span>Vulnerabilities</span>
                        <span class="vc-nav__badge">@_openCount</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/assets" ActiveClass="is-active" class="vc-nav__item">
                        <i class="bi bi-hdd-stack" aria-hidden="true"></i>
                        <span>Assets</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/remediation" ActiveClass="is-active" class="vc-nav__item">
                        <i class="bi bi-tools" aria-hidden="true"></i>
                        <span>Remediation</span>
                    </NavLink>
                </li>
                <AuthorizeView Roles="Administrator,Security Analyst">
                    <li>
                        <NavLink href="/verification" ActiveClass="is-active" class="vc-nav__item">
                            <i class="bi bi-patch-check" aria-hidden="true"></i>
                            <span>Verification</span>
                            @if (_hasPendingVerification)
                            {
                                <span class="vc-nav__dot" aria-label="Pending verifications"></span>
                            }
                        </NavLink>
                    </li>
                </AuthorizeView>
                <li>
                    <NavLink href="/alerts" ActiveClass="is-active" class="vc-nav__item">
                        <i class="bi bi-bell" aria-hidden="true"></i>
                        <span>Alerts</span>
                        @if (_unreadAlerts > 0)
                        {
                            <span class="vc-nav__badge vc-nav__badge--danger">@_unreadAlerts</span>
                        }
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/reports" ActiveClass="is-active" class="vc-nav__item">
                        <i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i>
                        <span>Reports</span>
                    </NavLink>
                </li>
            </ul>
        </div>

        <AuthorizeView Roles="Administrator">
            <div class="vc-nav__group">
                <div class="vc-nav__label">
                    <span>ADMINISTRATION</span>
                    <span class="vc-admin-tag">Admin</span>
                </div>
                <ul class="vc-nav__list">
                    <li>
                        <NavLink href="/users" ActiveClass="is-active" class="vc-nav__item">
                            <i class="bi bi-people" aria-hidden="true"></i>
                            <span>Users</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="/settings" ActiveClass="is-active" class="vc-nav__item">
                            <i class="bi bi-gear" aria-hidden="true"></i>
                            <span>Settings</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="/audit-logs" ActiveClass="is-active" class="vc-nav__item">
                            <i class="bi bi-journal-text" aria-hidden="true"></i>
                            <span>Audit Logs</span>
                        </NavLink>
                    </li>
                </ul>
            </div>
        </AuthorizeView>
    </nav>

    <div class="vc-sidebar__foot">
        <div class="vc-sync-card">
            <div class="vc-sync-card__head">
                <span class="vc-sync-card__title">Last Greenbone sync</span>
            </div>
            <div class="vc-sync-card__time">
                <span class="vc-dot vc-dot--ok" aria-hidden="true"></span>
                <span>@_lastSyncTime</span>
            </div>
            <div class="vc-sync-card__meta">@_lastSyncTask</div>
            <div class="vc-sync-card__hosts">@_assetCount hosts tracked</div>
        </div>

        <AuthorizeView>
            <Authorized Context="auth">
                @{
                    var displayName = _displayName ?? auth.User.Identity?.Name ?? "User";
                    var role = auth.User.FindFirst(ClaimTypes.Role)?.Value ?? Roles.Administrator;
                    var initials = GetInitials(displayName);
                }
                <div class="vc-user-card">
                    <div class="vc-avatar" aria-hidden="true">@initials</div>
                    <div class="vc-user-card__info">
                        <div class="vc-user-card__name">@displayName</div>
                        <div class="vc-user-card__role">@role</div>
                    </div>
                    <a href="/auth/logout" class="vc-user-card__logout" data-enhance-nav="false" aria-label="Log out" title="Log out">
                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</aside>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private int _openCount;
    private int _unreadAlerts;
    private bool _hasPendingVerification;
    private int _assetCount;
    private string _lastSyncTime = "Not synced";
    private string _lastSyncTask = "Weekly internal sweep";
    private string? _displayName;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _openCount = await db.Vulnerabilities.CountAsync(v =>
                v.Status == VulnerabilityStatus.Open ||
                v.Status == VulnerabilityStatus.InProgress ||
                v.Status == VulnerabilityStatus.FixedAwaitingVerification);
            _hasPendingVerification = await db.Vulnerabilities.AnyAsync(v => v.Status == VulnerabilityStatus.FixedAwaitingVerification);
            _unreadAlerts = await db.Alerts.CountAsync(a => !a.IsRead);
            _assetCount = await db.Assets.CountAsync(a => a.IsActive);

            var lastBatch = await db.ImportBatches
                .Where(b => b.CompletedAt != null)
                .OrderByDescending(b => b.CompletedAt)
                .FirstOrDefaultAsync();
            if (lastBatch is not null)
            {
                _lastSyncTime = lastBatch.CompletedAt!.Value.ToString("d MMM, HH:mm");
                _lastSyncTask = lastBatch.TargetName;
            }

            if (AuthState is not null)
            {
                var auth = await AuthState;
                var userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                if (!string.IsNullOrEmpty(userId))
                {
                    var u = await db.Users.AsNoTracking().FirstOrDefaultAsync(x => x.Id == userId);
                    if (u is not null) _displayName = u.FullName;
                }
            }
        }
        catch
        {
            // Fallback gracefully if DB is unavailable during design-time or startup.
        }
    }

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0][..1].ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }
}
