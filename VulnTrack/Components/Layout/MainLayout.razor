@inherits LayoutComponentBase

<div class="vc-shell">
    <input type="checkbox" id="vc-nav-toggle" class="vc-nav-toggle" aria-hidden="true" tabindex="-1" />
    <Sidebar />
    <label for="vc-nav-toggle" class="vc-backdrop" aria-hidden="true"></label>
    <main class="vc-main">@Body</main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>
