@using System.Globalization

@if (Values is { Count: >= 2 })
{
    var min = Values.Min();
    var max = Values.Max();
    var range = Math.Max(1e-6, max - min);
    var padX = 3.0;
    var padY = 4.0;
    var innerW = Math.Max(1.0, Width - padX * 2);
    var innerH = Math.Max(1.0, Height - padY * 2);

    var pts = new List<string>(Values.Count);
    double lastX = padX;
    double lastY = Height * 0.5;

    for (var i = 0; i < Values.Count; i++)
    {
        var x = padX + (i / (double)(Values.Count - 1)) * innerW;
        var norm = (max == min) ? 0.5 : (Values[i] - min) / range;
        var y = padY + (1.0 - norm) * innerH;
        pts.Add($"{x.ToString("0.##", CultureInfo.InvariantCulture)},{y.ToString("0.##", CultureInfo.InvariantCulture)}");
        if (i == Values.Count - 1)
        {
            lastX = x;
            lastY = y;
        }
    }

    <svg class="vc-sparkline"
         viewBox="0 0 @Width @Height"
         width="@Width"
         height="@Height"
         aria-hidden="true">
        <polyline fill="none"
                  stroke="@Color"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  vector-effect="non-scaling-stroke"
                  points="@string.Join(" ", pts)" />
        <circle cx="@lastX.ToString("0.##", CultureInfo.InvariantCulture)"
                cy="@lastY.ToString("0.##", CultureInfo.InvariantCulture)"
                r="2.5"
                fill="@Color" />
    </svg>
}

@code {
    [Parameter] public IReadOnlyList<double> Values { get; set; } = Array.Empty<double>();
    [Parameter] public string Color { get; set; } = "#14968C";
    [Parameter] public int Width { get; set; } = 96;
    [Parameter] public int Height { get; set; } = 32;
}
