<div class="vc-empty">
    <div class="vc-empty__icon" aria-hidden="true">
        <i class="bi @Icon"></i>
    </div>
    <h3 class="vc-empty__title">@Title</h3>
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <p class="vc-empty__msg">@Message</p>
    }
    @if (ChildContent is not null)
    {
        <div class="vc-empty__action">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter] public string Icon { get; set; } = "bi-inbox";
    [Parameter] public string Title { get; set; } = "Nothing to show";
    [Parameter] public string? Message { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
