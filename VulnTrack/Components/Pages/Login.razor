@page "/login"
@layout EmptyLayout
@rendermode InteractiveServer
@attribute [AllowAnonymous]

<PageTitle>Sign in | VulnTrack</PageTitle>

<div class="vc-login-shell">
    <div class="vc-login-split">
        <section class="vc-login-brand" aria-label="VulnTrack overview">
            <a href="/" class="vc-brand__link" data-enhance-nav="false">
                <svg class="vc-brand__mark" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
                    <circle cx="16" cy="16" r="14.5" fill="none" stroke="currentColor" stroke-width="1.25" opacity="0.55" />
                    <path d="M9.5 11.5 L14.5 22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M14.5 22 L24.5 5" fill="none" stroke="#14968c" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="vc-brand__text">
                    <span class="vc-brand__word" style="font-size:20px">Vuln<span>Track</span></span>
                    <span class="vc-brand__sub">SecOps Console</span>
                </span>
            </a>

            <div class="vc-login-brand__copy">
                <h1>Vulnerability management with verified closure.</h1>
                <p>Import authorized Greenbone scans, track remediation against SLA due dates, and close findings only after a rescan confirms the fix.</p>
            </div>

            <p class="vc-login-brand__foot">Scan only systems you are authorized to test.</p>
        </section>

        <main class="vc-login-panel">
            <div class="vc-login-card">
                <h2>Sign in</h2>
                <p class="vc-login-card__sub">Enter your VulnTrack credentials to open the console.</p>

                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="vc-login-error" role="alert">
                        <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                        <span>@ErrorMessage</span>
                    </div>
                }

                <form method="post" action="/auth/login" data-enhance="false" class="vc-form-grid">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="@ReturnUrl" />

                    <div class="vc-field">
                        <label for="login-user">Email / Username</label>
                        <input id="login-user"
                               name="email"
                               type="text"
                               class="vc-input"
                               autocomplete="username"
                               placeholder="andrea.reyes@vulntrack.local"
                               required />
                    </div>

                    <div class="vc-field">
                        <label for="login-pass">Password</label>
                        <div class="vc-pass-wrap">
                            <input id="login-pass"
                                   name="password"
                                   type="@(_showPassword ? "text" : "password")"
                                   class="vc-input"
                                   autocomplete="current-password"
                                   placeholder="Enter your password"
                                   required />
                            <button type="button"
                                    class="vc-pass-toggle"
                                    aria-label="@(_showPassword ? "Hide password" : "Show password")"
                                    @onclick="() => _showPassword = !_showPassword">
                                <i class="bi @(_showPassword ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="vc-btn vc-btn--primary" style="width:100%;height:40px;margin-top:4px">
                        Sign in
                    </button>
                </form>

                <p class="vc-login-card__note">Authorized users only</p>
            </div>
        </main>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")] public string? ErrorCode { get; set; }
    [SupplyParameterFromQuery(Name = "ReturnUrl")] public string? ReturnUrl { get; set; }

    private bool _showPassword;

    private string? ErrorMessage => ErrorCode switch
    {
        "missing" => "Enter both your username and password to sign in.",
        "disabled" => "This account has been disabled. Contact an administrator.",
        "invalid" => "Invalid username or password. Verify your credentials and try again.",
        _ => null
    };
}
