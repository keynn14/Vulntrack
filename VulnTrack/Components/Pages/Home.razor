@page "/"
@layout EmptyLayout
@* InteractiveServer is required so OnAfterRenderAsync and IJSRuntime run in Blazor Web App;
   prerendering remains enabled so the initial HTML is server-rendered on first load. *@
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JS
@* [AllowAnonymous] is active so the landing page remains public while authenticated console pages use [Authorize]. *@
@attribute [AllowAnonymous]

<PageTitle>VulnTrack | Vulnerability management</PageTitle>

<div class="vt">
    <a class="vt-skip" href="#main">Skip to content</a>

    <header class="vt-nav" id="vt-nav">
        <div class="vt-container vt-nav__inner">
            <a class="vt-logo" href="/" aria-label="VulnTrack home">
                <svg class="vt-logo__mark" viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
                    <circle cx="16" cy="16" r="14.5" fill="none" stroke="currentColor" stroke-width="1.25" opacity="0.55" />
                    <path d="M9.5 11.5 L14.5 22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M14.5 22 L24.5 5" fill="none" stroke="#14968c" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="vt-logo__word">Vuln<span>Track</span></span>
            </a>

            <nav aria-label="Primary">
                <ul class="vt-nav__links">
                    <li><a href="#how-it-works">How it works</a></li>
                    <li><a href="#features">Features</a></li>
                    <li><a href="#who">Who uses it</a></li>
                </ul>
            </nav>

            @* Target login route will be @page "/login" on Login.razor; data-enhance-nav="false" ensures clean navigation without leaving stale JS loops. *@
            <a class="vt-btn vt-btn--primary vt-btn--sm" href="login" data-enhance-nav="false">Log in</a>
        </div>
    </header>

    <main id="main">
        <section class="vt-hero" id="top" aria-labelledby="hero-title">
            <canvas class="vt-hero__net" aria-hidden="true"></canvas>

            <div class="vt-container vt-hero__inner">
                <div class="vt-hero__copy">
                    <div class="vt-hero__layer" data-speed="0.16">
                        <h1 id="hero-title" class="vt-hero__title">
                            <span class="vt-hero__line"><span data-intro style="--d:.1s">Every vulnerability</span></span>
                            <span class="vt-hero__line"><span data-intro style="--d:.22s">gets an owner,</span></span>
                            <span class="vt-hero__line"><span data-intro style="--d:.34s">a deadline, and</span></span>
                            <span class="vt-hero__line"><span data-intro style="--d:.46s"><span class="vt-accent">proof it's fixed.</span></span></span>
                        </h1>
                    </div>

                    <div class="vt-hero__layer" data-speed="0.26">
                        <p class="vt-hero__sub" data-intro="fade" style="--d:.75s">
                            VulnTrack imports findings from authorized Greenbone scans, ranks them by real risk, and tracks each one to a named owner and due date. A finding closes only when a rescan confirms the fix.
                        </p>
                    </div>

                    <div class="vt-hero__layer" data-speed="0.36">
                        <div class="vt-hero__actions" data-intro="fade" style="--d:.9s">
                            @* Links to the future Login page (@page "/login"). *@
                            <a class="vt-btn vt-btn--primary" href="login" data-enhance-nav="false">Log in to VulnTrack</a>
                            <a class="vt-btn vt-btn--ghost" href="#how-it-works">See how a finding moves</a>
                        </div>
                        <p class="vt-hero__hint" data-intro="fade" style="--d:1.05s">Move your cursor over the network to scan it.</p>
                    </div>
                </div>

                <div class="vt-hero__cards" aria-hidden="true">
                    <div class="vt-fcard vt-fcard--1" data-depth="0.35">
                        <div class="vt-fcard__body">
                            <div class="vt-fcard__top">
                                <span class="vt-cve">CVE-2024-21887</span>
                                <span class="vt-chip" data-status="open">Critical 9.1</span>
                            </div>
                            <p class="vt-fcard__asset">vpn-gw-01 · Ivanti Connect Secure</p>
                            <p class="vt-fcard__meta">Owner M. Santos · due 30 Nov</p>
                        </div>
                    </div>

                    <div class="vt-fcard vt-fcard--2" data-depth="0.7">
                        <div class="vt-fcard__body">
                            <div class="vt-fcard__top">
                                <span class="vt-cve">CVE-2023-48795</span>
                                <span class="vt-chip" data-status="fixed">Fixed, awaiting rescan</span>
                            </div>
                            <p class="vt-fcard__asset">bastion-02 · OpenSSH (Terrapin)</p>
                            <p class="vt-fcard__meta">Rescan scheduled 24 Nov</p>
                        </div>
                    </div>

                    <div class="vt-fcard vt-fcard--3" data-depth="1.0">
                        <div class="vt-fcard__body">
                            <div class="vt-fcard__top">
                                <span class="vt-cve">CVE-2024-3094</span>
                                <span class="vt-chip" data-status="closed">Closed, verified by rescan</span>
                            </div>
                            <p class="vt-fcard__asset">build-runner-03 · xz-utils</p>
                            <p class="vt-fcard__meta">Verified 18 Nov</p>
                        </div>
                    </div>
                </div>
            </div>

            <canvas class="vt-hero__lens" aria-hidden="true"></canvas>
        </section>

        <section class="vt-story" id="how-it-works" aria-labelledby="story-title">
            <div class="vt-story__stage" data-stage="0">
                <div class="vt-container vt-story__grid">
                    <div class="vt-story__left">
                        <p class="vt-kicker">How it works</p>
                        <h2 id="story-title">Follow one finding from scan to closed</h2>
                        <p class="vt-story__caption" data-field="caption" aria-live="polite">
                            Greenbone reports CVE-2024-21887 on vpn-gw-01 during the nightly scan. VulnTrack imports it as a new finding.
                        </p>

                        <div class="vt-story__bar" aria-hidden="true"><span></span></div>

                        <ol class="vt-story__steps">
                            <li data-step="0" class="is-done is-current">
                                <span class="vt-step__num">01</span>
                                <span class="vt-step__label">Found</span>
                            </li>
                            <li data-step="1">
                                <span class="vt-step__num">02</span>
                                <span class="vt-step__label">Ranked</span>
                            </li>
                            <li data-step="2">
                                <span class="vt-step__num">03</span>
                                <span class="vt-step__label">Assigned</span>
                            </li>
                            <li data-step="3">
                                <span class="vt-step__num">04</span>
                                <span class="vt-step__label">Fixed</span>
                            </li>
                            <li data-step="4">
                                <span class="vt-step__num">05</span>
                                <span class="vt-step__label">Verified</span>
                            </li>
                        </ol>
                    </div>

                    <div class="vt-story__scene">
                        <div class="vt-story__tilt">
                            <div class="vt-ghost vt-ghost--1" aria-hidden="true">
                                <div class="vt-ghost__top">
                                    <span class="vt-cve">CVE-2024-6387</span>
                                    <span class="vt-chip" data-status="open">Critical 8.1</span>
                                </div>
                                <p class="vt-ghost__asset">web-01 · OpenSSH regreSSHion</p>
                            </div>

                            <div class="vt-ghost vt-ghost--2" aria-hidden="true">
                                <div class="vt-ghost__top">
                                    <span class="vt-cve">CVE-2024-4577</span>
                                    <span class="vt-chip" data-status="open">Critical 9.8</span>
                                </div>
                                <p class="vt-ghost__asset">intranet-php · PHP CGI injection</p>
                            </div>

                            <article class="vt-story__card">
                                <div class="vt-story__card-head">
                                    <span class="vt-cve">CVE-2024-21887</span>
                                    <span class="vt-sev">Critical 9.1</span>
                                </div>
                                <h3 class="vt-story__card-title">Ivanti Connect Secure command injection</h3>
                                <p class="vt-story__asset">vpn-gw-01 · 10.20.0.4</p>

                                <dl class="vt-story__meta">
                                    <div class="vt-story__row">
                                        <dt>Priority</dt>
                                        <dd data-field="priority">Not ranked yet</dd>
                                    </div>
                                    <div class="vt-story__row">
                                        <dt>Owner</dt>
                                        <dd data-field="owner">Unassigned</dd>
                                    </div>
                                    <div class="vt-story__row">
                                        <dt>Due date</dt>
                                        <dd data-field="due">Not set</dd>
                                    </div>
                                </dl>

                                <div class="vt-story__card-foot">
                                    <span class="vt-chip" data-field="status" data-status="open">Open</span>
                                    <svg class="vt-check" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
                                        <circle cx="16" cy="16" r="13.5" fill="none" stroke="currentColor" stroke-width="1.75" pathLength="1" />
                                        <path d="M8 16.5l5 5 11-11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" pathLength="1" />
                                    </svg>
                                </div>
                            </article>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="vt-features" id="features" aria-labelledby="features-title">
            <div class="vt-container vt-features__grid">
                <div class="vt-features__head">
                    <h2 id="features-title">Built for the work that starts after the scan</h2>
                    <p>Scanners produce long lists. VulnTrack turns each authorized scan into accountable remediation work with proof at the end.</p>
                </div>

                <ol class="vt-features__list">
                    <li class="vt-feature">
                        <span class="vt-feature__line" aria-hidden="true"></span>
                        <span class="vt-feature__num">01</span>
                        <h3 class="vt-feature__title">Import from Greenbone</h3>
                        <p class="vt-feature__desc">Load reports from authorized Greenbone scans. Findings are matched to known assets and duplicates are merged, not re-created.</p>
                    </li>
                    <li class="vt-feature">
                        <span class="vt-feature__line" aria-hidden="true"></span>
                        <span class="vt-feature__num">02</span>
                        <h3 class="vt-feature__title">Record what matters</h3>
                        <p class="vt-feature__desc">Each finding keeps its CVE, severity, affected asset, business impact, owner, due date and remediation status in one record.</p>
                    </li>
                    <li class="vt-feature">
                        <span class="vt-feature__line" aria-hidden="true"></span>
                        <span class="vt-feature__num">03</span>
                        <h3 class="vt-feature__title">Rank by real risk</h3>
                        <p class="vt-feature__desc">Severity is weighed against what the asset does for the business, so critical issues on critical systems rise to the top.</p>
                    </li>
                    <li class="vt-feature">
                        <span class="vt-feature__line" aria-hidden="true"></span>
                        <span class="vt-feature__num">04</span>
                        <h3 class="vt-feature__title">Track every deadline</h3>
                        <p class="vt-feature__desc">Due dates follow from priority. Overdue items are flagged for the owner and visible to analysts and administrators.</p>
                    </li>
                    <li class="vt-feature">
                        <span class="vt-feature__line" aria-hidden="true"></span>
                        <span class="vt-feature__num">05</span>
                        <h3 class="vt-feature__title">Verify before closing</h3>
                        <p class="vt-feature__desc">A finding marked fixed stays open until a rescan no longer detects it. Closure always has evidence behind it.</p>
                    </li>
                    <li class="vt-feature">
                        <span class="vt-feature__line" aria-hidden="true"></span>
                        <span class="vt-feature__num">06</span>
                        <h3 class="vt-feature__title">Report and audit</h3>
                        <p class="vt-feature__desc">See open, overdue and closed findings by asset or owner, with a history of every status change.</p>
                    </li>
                </ol>
            </div>
        </section>

        <section class="vt-who" id="who" aria-labelledby="who-title">
            <div class="vt-container">
                <h2 id="who-title">One record for everyone who touches a fix</h2>

                <div class="vt-who__cols">
                    <div class="vt-who__col" data-speed="20">
                        <h3>Administrators</h3>
                        <p>Manage users, roles and assets, connect the Greenbone scanner, and keep scan scope limited to systems you are authorized to test.</p>
                    </div>
                    <div class="vt-who__col" data-speed="50">
                        <h3>Security analysts</h3>
                        <p>Import scan results, review and rank findings, assign owners and deadlines, and confirm fixes with a rescan.</p>
                    </div>
                    <div class="vt-who__col" data-speed="80">
                        <h3>Asset owners</h3>
                        <p>See the findings on your systems, what to fix first and by when, and mark work done when a patch is applied.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="vt-closing" aria-labelledby="closing-title">
            <canvas class="vt-closing__net" aria-hidden="true"></canvas>

            <div class="vt-container vt-closing__inner">
                <h2 id="closing-title">See what needs fixing today</h2>
                <p>Sign in to view open findings, overdue items and the rescans waiting to confirm your fixes.</p>
                @* Links to the future Login page (@page "/login"). *@
                <a class="vt-btn vt-btn--primary" href="login" data-enhance-nav="false">Log in to VulnTrack</a>
            </div>
        </section>
    </main>

    <footer class="vt-footer">
        <div class="vt-container vt-footer__inner">
            <p>VulnTrack, a project for System Administration and Maintenance (IT23/L)</p>
            <p>Scan only systems you are authorized to test.</p>
        </div>
    </footer>
</div>

@code {
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Update the path below if home.js is moved from wwwroot/js/home.js.
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/home.js");
            await _module.InvokeVoidAsync("initHome");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disposeHome");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already disconnected before disposal.
            }
            catch (TaskCanceledException)
            {
                // Shutdown or navigation canceled the JS call.
            }
        }
    }
}
